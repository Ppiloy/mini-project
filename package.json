{
  "name": "thai-foreign-tax-credit-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/dev.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test --config=playwright.real-backend.config.ts",
    "preview": "vite preview",
    "migrations:verify": "tsx server/scripts/verify-migrations.ts",
    "demo:seed": "tsx server/scripts/bootstrap.ts seed",
    "demo:rotate": "tsx server/scripts/bootstrap.ts rotate",
    "ops:cleanup": "tsx server/scripts/operations.ts cleanup",
    "ops:preview-init": "tsx server/scripts/operations.ts preview-init",
    "ops:backup": "tsx server/scripts/operations.ts backup",
    "demo:reset": "tsx server/scripts/operations.ts reset-demo",
    "ops:restore": "tsx server/scripts/operations.ts restore",
    "verify:release": "npm run typecheck && npm test && npm run migrations:verify && npm run build"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "^5.2.8",
    "@hookform/resolvers": "^5.9.1",
    "@netlify/aws-lambda-compat": "2.0.2",
    "@netlify/blobs": "^11.1.4",
    "@netlify/database": "^1.0.0",
    "@netlify/functions": "^6.0.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "clsx": "^2.1.1",
    "connect-pg-simple": "^10.0.0",
    "decimal.js": "^10.6.0",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.18.4",
    "serverless-http": "^4.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.8",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "5.0.4",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "5.0.4"
  }
}
